# LocalApp 开发环境配置
# 复制此文件为 .env 并按需修改

# 数据存储目录（相对于 packages/server）
DATA_DIR=../../data

# JWT 签名密钥（开发环境用固定值即可）
JWT_SECRET=dev-jwt-secret-change-me

# 管理员 Bootstrap API Key（用于首次配置）
BOOTSTRAP_API_KEY=dev-api-key-change-me

# 可选：远程模板仓库 URL（不设置则使用内置模板）
# TEMPLATE_REPO_URL=https://github.com/example/template.git

# 可选：LLM 配置（用于 AI Agent 功能）
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# 可选：MinIO 对象存储（用于文件上传）
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=localapp-content
