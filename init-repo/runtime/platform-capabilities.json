{
  "$schema": "./capabilities.schema.json",
  "schemaVersion": 1,
  "platformVersion": "1.2.0",
  "content": {
    "upload": {
      "enabled": true,
      "maxBytes": 10485760,
      "validatesFileSignature": true
    },
    "read": {
      "enabled": true,
      "rangeRequests": true,
      "delete": false
    },
    "types": [
      {
        "extension": "png",
        "mimeType": "image/png",
        "inlinePreview": true
      },
      {
        "extension": "jpg",
        "mimeType": "image/jpeg",
        "inlinePreview": true
      },
      {
        "extension": "jpeg",
        "mimeType": "image/jpeg",
        "inlinePreview": true
      },
      {
        "extension": "gif",
        "mimeType": "image/gif",
        "inlinePreview": true
      },
      {
        "extension": "webp",
        "mimeType": "image/webp",
        "inlinePreview": true
      },
      {
        "extension": "svg",
        "mimeType": "image/svg+xml",
        "inlinePreview": true
      },
      {
        "extension": "pdf",
        "mimeType": "application/pdf",
        "inlinePreview": true
      }
    ]
  },
  "backend": {
    "stableMode": "named-sql",
    "namedSql": {
      "enabled": true,
      "transactions": true,
      "maxRows": 1000,
      "maxBytes": 1048576,
      "systemParams": [
        "currentUserId",
        "ownerId",
        "now"
      ]
    },
    "hostedActions": {
      "enabled": false,
      "stable": false
    },
    "securityContracts": {
      "enabled": true,
      "contractVersion": 1,
      "requiredFromPlatformVersion": "1.1.0",
      "generatedTemplates": [
        "public-v1",
        "authenticated-v1",
        "owner-read-v1",
        "owner-create-v1",
        "owner-update-v1",
        "owner-delete-v1",
        "member-read-v1",
        "member-create-v1",
        "member-update-v1",
        "member-delete-v1",
        "parent-owner-v1",
        "transition-v1"
      ],
      "customScenarios": true
    }
  },
  "identity": {
    "currentUser": true,
    "pageOwner": true,
    "groups": true
  },
  "verification": {
    "enabled": true,
    "isolatedDatabase": true,
    "identities": [
      "owner",
      "member"
    ],
    "defaultTtlSeconds": 900,
    "maxTtlSeconds": 1800,
    "maxConcurrentSessions": 8,
    "maxDatabaseBytes": 67108864
  }
}
