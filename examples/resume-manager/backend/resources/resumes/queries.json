{
  "$schema": "https://localapp.dev/schemas/backend/queries.schema.json",
  "queries": {
    "$resumes.count": {
      "access": "authenticated",
      "kind": "query",
      "params": {},
      "result": {
        "maxBytes": 4096,
        "maxRows": 1,
        "mode": "aggregate"
      },
      "security": {
        "mode": "custom",
        "access": "authenticated",
        "resources": ["resumes"],
        "systemParams": ["currentUserId", "ownerId"],
        "scenarios": [
          { "identity": "owner", "expect": "allow" },
          { "identity": "member", "expect": "allow" }
        ]
      },
      "sql": "SELECT COUNT(*) AS count FROM resumes WHERE (:currentUserId = :ownerId OR created_by = :currentUserId)"
    },
    "$resumes.get": {
      "access": "authenticated",
      "kind": "query",
      "params": {
        "id": {
          "required": true,
          "type": "number"
        }
      },
      "result": {
        "maxBytes": 8192,
        "maxRows": 1,
        "mode": "single"
      },
      "security": {
        "mode": "custom",
        "access": "authenticated",
        "resources": ["resumes"],
        "systemParams": ["currentUserId", "ownerId"],
        "scenarios": [
          { "identity": "owner", "expect": "allow" },
          { "identity": "member", "expect": "allow" }
        ]
      },
      "sql": "SELECT * FROM resumes WHERE id = :id AND (:currentUserId = :ownerId OR created_by = :currentUserId)"
    },
    "$resumes.list": {
      "access": "authenticated",
      "kind": "query",
      "params": {
        "limit": {
          "required": true,
          "type": "number"
        },
        "offset": {
          "required": true,
          "type": "number"
        }
      },
      "result": {
        "maxBytes": 65536,
        "maxRows": 100,
        "mode": "page"
      },
      "security": {
        "mode": "custom",
        "access": "authenticated",
        "resources": ["resumes"],
        "systemParams": ["currentUserId", "ownerId"],
        "scenarios": [
          { "identity": "owner", "expect": "allow" },
          { "identity": "member", "expect": "allow" }
        ]
      },
      "sql": "SELECT * FROM resumes WHERE (:currentUserId = :ownerId OR created_by = :currentUserId) ORDER BY id DESC LIMIT :limit OFFSET :offset"
    }
  }
}
