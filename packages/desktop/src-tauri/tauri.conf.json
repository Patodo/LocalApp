{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalApp",
  "version": "0.1.0",
  "identifier": "com.localapp.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalApp",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/local-runtime": "local-runtime",
      "resources/npm": "npm",
      "runner/localapp-runner.mjs": "runner/localapp-runner.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "development-only"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["localapp"]
      }
    }
  }
}
