{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalApp",
  "version": "0.1.0",
  "identifier": "com.localapp.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/server": "server",
      "resources/node": "node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "development-only"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["localapp"]
      }
    }
  }
}
