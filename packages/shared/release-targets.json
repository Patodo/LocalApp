{
  "schemaVersion": 2,
  "npmPackage": {
    "name": "localapp",
    "filenameTemplate": "localapp-{version}.tgz"
  },
  "nativeAdapters": [
    {
      "platform": "linux",
      "arch": "x64",
      "target": "linux-x64"
    },
    {
      "platform": "darwin",
      "arch": "arm64",
      "target": "darwin-arm64"
    },
    {
      "platform": "darwin",
      "arch": "x64",
      "target": "darwin-x64"
    },
    {
      "platform": "win32",
      "arch": "x64",
      "target": "win32-x64"
    }
  ]
}
