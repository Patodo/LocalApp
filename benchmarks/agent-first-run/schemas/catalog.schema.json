{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localapp.dev/schemas/agent-first-run/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "benchmarkSetVersion", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "benchmarkSetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "requirements": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "prompt", "requiredCapabilities", "verificationIdentities", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "category": { "enum": ["basic-crud", "personal-ownership", "approval-transition", "image-pdf-content", "aggregate-pagination", "multi-table-complex"] },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "requiredCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "verificationIdentities": { "type": "array", "minItems": 1, "items": { "enum": ["owner", "member"] }, "uniqueItems": true },
          "acceptance": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
