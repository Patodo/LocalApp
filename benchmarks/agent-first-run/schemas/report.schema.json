{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localapp.dev/schemas/agent-first-run/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkSetVersion", "generatedAt", "platformVersion", "cliVersion", "summary", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkSetVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "platformVersion": { "type": "string" },
    "cliVersion": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedRuns", "passedRuns", "firstDeliveryPassed", "firstDeliverySuccessRate", "medianFirstVisibleMs", "totalRetries", "totalRepairs"],
      "properties": {
        "completedRuns": { "type": "integer", "minimum": 1 },
        "passedRuns": { "type": "integer", "minimum": 0 },
        "firstDeliveryPassed": { "type": "integer", "minimum": 0 },
        "firstDeliverySuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "medianFirstVisibleMs": { "type": "number", "minimum": 0 },
        "totalRetries": { "type": "integer", "minimum": 0 },
        "totalRepairs": { "type": "integer", "minimum": 0 }
      }
    },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "./run.schema.json" } }
  }
}
